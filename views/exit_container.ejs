<div id="exit-container">
  <img id="start-over-panel" class="exit-panel" src="/images/start_over.png" />
  <img
    id="save-exit-panel"
    class="exit-panel"
    src="/images/riddles/ui/save_exit_panel.png"
  />

  <button
    id="save-exit-button"
    class="exit-button"
    data-action="save-and-exit"
  ></button>
  <button
    id="start-over-button"
    class="exit-button"
    data-action="start-over"
  ></button>

  <button id="cancel-button" data-action="cancel-exit"></button>
  <button id="sign-out-button" data-action="save-and-exit"></button>
</div>
