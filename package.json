{
  "name": "pupsquest",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.ts",
    "start:online": "node drizzle/migrate.ts && node drizzle/seeds/index.ts && node server.ts",
    "dev": "node --watch server.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "seed": "node drizzle/seeds/index.ts",
    "db:migrate": "node drizzle/migrate.ts",
    "db:reset": "docker compose up -d --wait && docker compose exec db psql -U pupsquest -c \"drop schema public cascade; drop schema if exists drizzle cascade; create schema public;\" && npm run db:migrate && npm run seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.4",
    "prettier": "3.10.1",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
