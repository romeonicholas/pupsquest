    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.4",
    "nodemon": "^3.1.10",
    "prettier": "3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
